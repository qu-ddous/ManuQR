# MenuQR Environment Variables

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Public App URL for generating menu links and QR codes
# Defaults to window.location.origin in the browser if not specified
VITE_APP_URL=http://localhost:5173

